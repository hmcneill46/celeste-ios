<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <Reference Include="MonoMod.Utils" HintPath="$(MonoModUtilsPath)" Private="true" />
  </ItemGroup>
  <Target Name="ValidatePinnedMonoMod" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MonoModUtilsPath)' == '' or !Exists('$(MonoModUtilsPath)')"
           Text="MonoModUtilsPath must identify the exact pinned host build." />
  </Target>
</Project>
