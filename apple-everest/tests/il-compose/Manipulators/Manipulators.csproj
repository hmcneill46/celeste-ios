<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AppleEverestIlComposeManipulators</AssemblyName>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="MonoMod.Backports" Version="1.1.2" />
    <PackageReference Include="MonoMod.ILHelpers" Version="1.1.0" />
    <Reference Include="MonoMod.Utils" HintPath="$(MonoModUtilsPath)" Private="true" />
  </ItemGroup>
  <Target Name="ValidatePinnedMonoMod" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MonoModUtilsPath)' == '' or !Exists('$(MonoModUtilsPath)')"
           Text="MonoModUtilsPath must identify the exact pinned host build." />
  </Target>
</Project>
