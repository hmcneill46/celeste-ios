<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(MonoModRuntimeDetourPath)/MonoMod.RuntimeDetour.dll" Private="true" />
    <Reference Include="MonoMod.Utils" HintPath="$(MonoModRuntimeDetourPath)/MonoMod.Utils.dll" Private="true" />
    <Reference Include="MonoMod.Core" HintPath="$(MonoModRuntimeDetourPath)/MonoMod.Core.dll" Private="true" />
    <Reference Include="MonoMod.Iced" HintPath="$(MonoModRuntimeDetourPath)/MonoMod.Iced.dll" Private="true" />
    <Reference Include="Mono.Cecil" HintPath="$(MonoCecilPath)" Private="true" />
    <Reference Include="MonoMod.Backports" HintPath="$(MonoModDependencyPath)/MonoMod.Backports.dll" Private="true" />
    <Reference Include="MonoMod.ILHelpers" HintPath="$(MonoModDependencyPath)/MonoMod.ILHelpers.dll" Private="true" />
  </ItemGroup>
</Project>
