<Project>
  <!-- Copy this file to tvos/Local.Build.props. The copy is ignored by Git. -->
  <PropertyGroup>
    <!-- Changing this value creates a different app identity and UserDefaults
         domain, so existing saves will appear unavailable. -->
    <ApplicationId>com.your-local-name.celeste-tvos</ApplicationId>
    <CodesignKey>Apple Development</CodesignKey>
    <DevelopmentTeam>TEAM_ID</DevelopmentTeam>
    <CodesignProvision>PROVISIONING_PROFILE_NAME_OR_UUID</CodesignProvision>
  </PropertyGroup>
</Project>
