<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>16.0</TargetPlatformMinVersion>
    <ApplicationId>io.github.roootthefox.celestetvos.stage3a-closure</ApplicationId>
    <ApplicationTitle>Celeste Stage 3A Closure</ApplicationTitle>
    <ApplicationDisplayVersion>3.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <TrimMode>full</TrimMode>
    <MtouchLink>Full</MtouchLink>
    <UseInterpreter>false</UseInterpreter>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CelesteManagedProject Condition="'$(CelesteManagedProject)' == ''">$(MSBuildThisFileDirectory)..\..\.build\celeste-managed\current\patched\Celeste.Modern.csproj</CelesteManagedProject>
    <CelesteContentProject Condition="'$(CelesteContentProject)' == ''">$(MSBuildThisFileDirectory)..\..\.build\celeste-managed\current\patched\Celeste.Content.Modern.csproj</CelesteContentProject>
    <TvOSHostNativeRoot>$(MSBuildThisFileDirectory)..\..\.build\tvos-host\native</TvOSHostNativeRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CelesteManagedProject)" />
    <ProjectReference Include="$(CelesteContentProject)" />
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!-- The closure roots the callable managed boundary by creating a delegate,
       but never invokes it. Static XCFramework linkage matches the Stage 2 host. -->
  <ItemGroup>
    <NativeReference Include="$(TvOSHostNativeRoot)\SDL2.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Foundation UIKit AVFoundation AudioToolbox CoreBluetooth CoreGraphics CoreHaptics GameController IOSurface Metal OpenGLES QuartzCore</Frameworks>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FNA3D.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FAudio.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\Theorafile.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\tvStubs.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\MoltenVK.xcframework">
      <Kind>Static</Kind>
      <SmartLink>false</SmartLink>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
    </NativeReference>
  </ItemGroup>

  <Target Name="ValidateStage3AInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CelesteManagedProject)')"
           Text="Generated Celeste project is missing. Run scripts/prepare-celeste-managed.sh first." />
    <Error Condition="!Exists('$(CelesteContentProject)')"
           Text="Generated Celeste.Content identity project is missing." />
    <Error Condition="!Exists('$(TvOSHostNativeRoot)\MoltenVK.xcframework\Info.plist')"
           Text="Prepared Stage 1 native inputs are missing." />
    <Error Condition="'$(UseInterpreter)' != 'false'"
           Text="Stage 3A device closure must use full AOT with UseInterpreter=false." />
  </Target>
</Project>
