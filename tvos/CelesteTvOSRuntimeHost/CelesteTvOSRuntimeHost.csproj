<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>16.0</TargetPlatformMinVersion>
    <ApplicationId>io.github.roootthefox.celestetvos.stage3b</ApplicationId>
    <ApplicationTitle>Celeste tvOS Stage 3B</ApplicationTitle>
    <ApplicationDisplayVersion>3.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AssemblyInformationalVersion>3.0.0+stage3b</AssemblyInformationalVersion>
    <CelesteLaunchMode Condition="'$(CelesteLaunchMode)' == ''">Stage2Diagnostic</CelesteLaunchMode>
    <CelesteRuntimeEnabled Condition="'$(CelesteLaunchMode)' == 'CelestePreflight' or '$(CelesteLaunchMode)' == 'Celeste'">true</CelesteRuntimeEnabled>
    <CelesteTvOSRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</CelesteTvOSRepoRoot>
    <TvOSHostStageRoot>$(CelesteTvOSRepoRoot)\.build\tvos-host</TvOSHostStageRoot>
    <TvOSHostNativeRoot>$(TvOSHostStageRoot)\native</TvOSHostNativeRoot>
    <CelesteRuntimeRoot Condition="'$(CelesteRuntimeRoot)' == ''">$(CelesteTvOSRepoRoot)\.build\celeste-runtime\current</CelesteRuntimeRoot>
    <CelesteRuntimeManagedRoot>$(CelesteRuntimeRoot)\managed</CelesteRuntimeManagedRoot>
    <CelesteRuntimeContentRoot>$(CelesteRuntimeRoot)\content\Content</CelesteRuntimeContentRoot>
    <Stage3BFnaExtensionTargets>$(MSBuildThisFileDirectory)Stage3BFnaExtension.targets</Stage3BFnaExtensionTargets>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <MtouchLink Condition="'$(Configuration)' == 'Release'">Full</MtouchLink>
    <UseInterpreter>false</UseInterpreter>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'Stage2Diagnostic'">$(DefineConstants);STAGE2_DIAGNOSTIC</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePreflight'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_PREFLIGHT</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'Celeste'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_GAME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Stage3BLegacyXnbReaders.cs" />
    <ProjectReference Include="..\FNA.TvOS\FNA.TvOS.csproj"
                      AdditionalProperties="CustomAfterMicrosoftCommonTargets=$(Stage3BFnaExtensionTargets)" />
    <Compile Include="..\CelesteTvOSHost\Stage2Game.cs" Link="Stage2Diagnostic\Stage2Game.cs" />
    <Compile Include="..\CelesteTvOSHost\Stage2Log.cs" Link="Stage2Diagnostic\Stage2Log.cs" />
    <Compile Include="..\CelesteTvOSHost\NativeInteropSelfTest.cs" Link="Stage2Diagnostic\NativeInteropSelfTest.cs" />
    <Compile Include="..\CelesteTvOSHost\LifecycleMonitor.cs" Link="Stage2Diagnostic\LifecycleMonitor.cs" />
    <BundleResource Include="..\CelesteTvOSHost\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup Condition="'$(CelesteRuntimeEnabled)' == 'true'">
    <ProjectReference Include="$(CelesteRuntimeManagedRoot)\Celeste.Modern.csproj"
                      AdditionalProperties="CelesteTvOSRepoRoot=$(CelesteTvOSRepoRoot);CelesteManagedGeneratedRoot=$(CelesteRuntimeManagedRoot);CustomAfterMicrosoftCommonTargets=$(Stage3BFnaExtensionTargets)" />
    <ProjectReference Include="$(CelesteRuntimeManagedRoot)\Celeste.Content.Modern.csproj"
                      AdditionalProperties="CelesteManagedGeneratedRoot=$(CelesteRuntimeManagedRoot)" />
    <BundleResource Include="$(CelesteRuntimeContentRoot)\**\*"
                    LogicalName="Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootDescriptor Include="Stage3BLinker.xml" />
  </ItemGroup>

  <!-- Static imports resolve through __Internal. ForceLoad retains those
       exports; the framework list remains the accepted Stage 1 link-probe set. -->
  <ItemGroup>
    <NativeReference Include="$(TvOSHostNativeRoot)\SDL2.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
      <Frameworks>Foundation UIKit AVFoundation AudioToolbox CoreBluetooth CoreGraphics CoreHaptics GameController IOSurface Metal OpenGLES QuartzCore</Frameworks>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FNA3D.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FAudio.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\Theorafile.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\tvStubs.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\MoltenVK.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad><IsCxx>true</IsCxx>
    </NativeReference>
  </ItemGroup>

  <Target Name="ValidateCelesteLaunchMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CelesteLaunchMode)' != 'Stage2Diagnostic' and '$(CelesteLaunchMode)' != 'CelestePreflight' and '$(CelesteLaunchMode)' != 'Celeste'"
           Text="CelesteLaunchMode must be Stage2Diagnostic, CelestePreflight, or Celeste." />
    <Error Condition="!Exists('$(TvOSHostStageRoot)\normalized-manifest.json')"
           Text="Prepared Stage 1 native inputs are missing. Run scripts/prepare-tvos-host-native.sh." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and !Exists('$(CelesteRuntimeManagedRoot)\Celeste.Modern.csproj')"
           Text="Stage 3B managed input is missing. Run scripts/prepare-celeste-tvos-runtime.sh." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and !Exists('$(CelesteRuntimeContentRoot)\Effects\Border.xnb')"
           Text="Stage 3B Content input is missing. Run scripts/prepare-celeste-tvos-runtime.sh without --managed-only." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and Exists('$(CelesteRuntimeContentRoot)\FMOD')"
           Text="Stage 3B Content must not contain the FMOD tree." />
  </Target>

  <Import Project="..\Local.Build.props" Condition="Exists('..\Local.Build.props')" />
</Project>
