<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>16.0</TargetPlatformMinVersion>
    <ApplicationId>io.github.roootthefox.celestetvos.stage3b</ApplicationId>
    <ApplicationTitle>Celeste tvOS Stage 3B</ApplicationTitle>
    <ApplicationDisplayVersion>3.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AssemblyInformationalVersion>3.0.0+stage3b</AssemblyInformationalVersion>
    <CelesteLaunchMode Condition="'$(CelesteLaunchMode)' == ''">Stage2Diagnostic</CelesteLaunchMode>
    <CelesteRuntimeEnabled Condition="'$(CelesteLaunchMode)' == 'CelestePreflight' or '$(CelesteLaunchMode)' == 'Celeste' or '$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic' or '$(CelesteLaunchMode)' == 'CelesteAudio'">true</CelesteRuntimeEnabled>
    <FmodDiagnosticEnabled Condition="'$(CelesteLaunchMode)' == 'FmodDiagnostic'">true</FmodDiagnosticEnabled>
    <CelesteAudioEnabled Condition="'$(CelesteLaunchMode)' == 'CelesteAudio'">true</CelesteAudioEnabled>
    <CelesteTvOSRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</CelesteTvOSRepoRoot>
    <TvOSHostStageRoot>$(CelesteTvOSRepoRoot)\.build\tvos-host</TvOSHostStageRoot>
    <TvOSHostNativeRoot>$(TvOSHostStageRoot)\native</TvOSHostNativeRoot>
    <CelesteRuntimeRoot Condition="'$(CelesteRuntimeRoot)' == '' and '$(CelesteAudioEnabled)' == 'true'">$(CelesteTvOSRepoRoot)\.build\celeste-runtime\stage5b-current</CelesteRuntimeRoot>
    <CelesteRuntimeRoot Condition="'$(CelesteRuntimeRoot)' == ''">$(CelesteTvOSRepoRoot)\.build\celeste-runtime\stage3c-current</CelesteRuntimeRoot>
    <CelesteRuntimeManagedRoot>$(CelesteRuntimeRoot)\managed</CelesteRuntimeManagedRoot>
    <CelesteRuntimeContentRoot>$(CelesteRuntimeRoot)\content\Content</CelesteRuntimeContentRoot>
    <FmodDiagnosticStageRoot Condition="'$(FmodDiagnosticStageRoot)' == ''">$(CelesteTvOSRepoRoot)\.build\fmod-tvos\current</FmodDiagnosticStageRoot>
    <FmodNativeEnabled Condition="'$(FmodDiagnosticEnabled)' == 'true' or '$(CelesteAudioEnabled)' == 'true'">true</FmodNativeEnabled>
    <Stage3BFnaExtensionTargets>$(MSBuildThisFileDirectory)Stage3BFnaExtension.targets</Stage3BFnaExtensionTargets>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <MtouchLink Condition="'$(Configuration)' == 'Release'">Full</MtouchLink>
    <UseInterpreter>false</UseInterpreter>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'Stage2Diagnostic'">$(DefineConstants);STAGE2_DIAGNOSTIC</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'FmodDiagnostic' and '$(RuntimeIdentifier)' == 'tvos-arm64'">$(DefineConstants);FMOD_DIAGNOSTIC_DEVICE</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'FmodDiagnostic' and '$(RuntimeIdentifier)' != 'tvos-arm64'">$(DefineConstants);FMOD_DIAGNOSTIC_UNAVAILABLE</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePreflight'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_PREFLIGHT</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'Celeste'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_GAME</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelesteAudio' and '$(RuntimeIdentifier)' == 'tvos-arm64'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_GAME;CELESTE_AUDIO</DefineConstants>
    <Stage5BAudioScenario Condition="'$(Stage5BAudioScenario)' == ''">normal</Stage5BAudioScenario>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelesteAudio' and ('$(Stage5BAudioScenario)' == 'prologue-normal' or '$(Stage5BAudioScenario)' == 'prologue-skip')">$(DefineConstants);CELESTE_PROLOGUE_DIAGNOSTIC</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelesteAudio' and '$(Stage5BAudioScenario)' == 'prologue-normal'">$(DefineConstants);STAGE3C_SCENARIO_NORMAL</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelesteAudio' and '$(Stage5BAudioScenario)' == 'prologue-skip'">$(DefineConstants);STAGE3C_SCENARIO_SKIP</DefineConstants>
    <Stage3CPrologueScenario Condition="'$(Stage3CPrologueScenario)' == ''">normal</Stage3CPrologueScenario>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic'">$(DefineConstants);CELESTE_RUNTIME;CELESTE_GAME;CELESTE_PROLOGUE_DIAGNOSTIC</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic' and '$(Stage3CPrologueScenario)' == 'normal'">$(DefineConstants);STAGE3C_SCENARIO_NORMAL</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic' and '$(Stage3CPrologueScenario)' == 'skip'">$(DefineConstants);STAGE3C_SCENARIO_SKIP</DefineConstants>
    <DefineConstants Condition="'$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic' and '$(Stage3CPrologueScenario)' == 'manual'">$(DefineConstants);STAGE3C_SCENARIO_MANUAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Stage3BLegacyXnbReaders.cs" />
    <ProjectReference Include="..\FNA.TvOS\FNA.TvOS.csproj"
                      AdditionalProperties="CustomAfterMicrosoftCommonTargets=$(Stage3BFnaExtensionTargets)" />
    <Compile Include="..\CelesteTvOSHost\Stage2Game.cs" Link="Stage2Diagnostic\Stage2Game.cs" />
    <Compile Include="..\CelesteTvOSHost\Stage2Log.cs" Link="Stage2Diagnostic\Stage2Log.cs" />
    <Compile Include="..\CelesteTvOSHost\NativeInteropSelfTest.cs" Link="Stage2Diagnostic\NativeInteropSelfTest.cs" />
    <Compile Include="..\CelesteTvOSHost\LifecycleMonitor.cs" Link="Stage2Diagnostic\LifecycleMonitor.cs" />
    <BundleResource Include="..\CelesteTvOSHost\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup Condition="'$(CelesteRuntimeEnabled)' == 'true'">
    <ProjectReference Include="$(CelesteRuntimeManagedRoot)\Celeste.Modern.csproj"
                      AdditionalProperties="CelesteTvOSRepoRoot=$(CelesteTvOSRepoRoot);CelesteManagedGeneratedRoot=$(CelesteRuntimeManagedRoot);CustomAfterMicrosoftCommonTargets=$(Stage3BFnaExtensionTargets)" />
    <ProjectReference Include="$(CelesteRuntimeManagedRoot)\Celeste.Content.Modern.csproj"
                      AdditionalProperties="CelesteManagedGeneratedRoot=$(CelesteRuntimeManagedRoot)" />
    <BundleResource Include="$(CelesteRuntimeContentRoot)\**\*"
                    LogicalName="Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootDescriptor Include="Stage3BLinker.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(FmodNativeEnabled)' == 'true' and '$(RuntimeIdentifier)' == 'tvos-arm64'">
    <BundleResource Include="$(FmodDiagnosticStageRoot)\banks\Content\FMOD\**\*.bank"
                    LogicalName="Content\FMOD\%(RecursiveDir)%(Filename)%(Extension)" />
    <NativeReference Include="$(FmodDiagnosticStageRoot)\xcframeworks\FMOD.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(FmodDiagnosticStageRoot)\xcframeworks\FMODStudio.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad><IsCxx>true</IsCxx>
    </NativeReference>
    <NativeReference Include="$(FmodDiagnosticStageRoot)\xcframeworks\FMODSDL.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <!-- Static imports resolve through __Internal. ForceLoad retains those
       exports; the framework list remains the accepted Stage 1 link-probe set. -->
  <ItemGroup>
    <NativeReference Include="$(TvOSHostNativeRoot)\SDL2.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
      <Frameworks>Foundation UIKit AVFoundation AudioToolbox CoreBluetooth CoreGraphics CoreHaptics GameController IOSurface Metal OpenGLES QuartzCore</Frameworks>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FNA3D.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\FAudio.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\Theorafile.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\tvStubs.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(TvOSHostNativeRoot)\MoltenVK.xcframework">
      <Kind>Static</Kind><SmartLink>false</SmartLink><ForceLoad>true</ForceLoad><IsCxx>true</IsCxx>
    </NativeReference>
  </ItemGroup>

  <Target Name="ValidateCelesteLaunchMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CelesteLaunchMode)' != 'Stage2Diagnostic' and '$(CelesteLaunchMode)' != 'CelestePreflight' and '$(CelesteLaunchMode)' != 'Celeste' and '$(CelesteLaunchMode)' != 'CelestePrologueDiagnostic' and '$(CelesteLaunchMode)' != 'FmodDiagnostic' and '$(CelesteLaunchMode)' != 'CelesteAudio'"
           Text="CelesteLaunchMode must be Stage2Diagnostic, CelestePreflight, Celeste, CelestePrologueDiagnostic, FmodDiagnostic, or CelesteAudio." />
    <Error Condition="'$(CelesteAudioEnabled)' == 'true' and '$(RuntimeIdentifier)' != 'tvos-arm64'"
           Text="CelesteAudio is device-only. Use Celeste for the arm64 simulator no-audio lane." />
    <Error Condition="'$(CelesteAudioEnabled)' == 'true' and '$(Stage5BAudioScenario)' != 'normal' and '$(Stage5BAudioScenario)' != 'prologue-normal' and '$(Stage5BAudioScenario)' != 'prologue-skip'"
           Text="Stage5BAudioScenario must be normal, prologue-normal, or prologue-skip." />
    <Error Condition="'$(CelesteLaunchMode)' == 'CelestePrologueDiagnostic' and '$(Stage3CPrologueScenario)' != 'normal' and '$(Stage3CPrologueScenario)' != 'skip' and '$(Stage3CPrologueScenario)' != 'manual'"
           Text="Stage3CPrologueScenario must be normal, skip, or manual." />
    <Error Condition="!Exists('$(TvOSHostStageRoot)\normalized-manifest.json')"
           Text="Prepared Stage 1 native inputs are missing. Run scripts/prepare-tvos-host-native.sh." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and !Exists('$(CelesteRuntimeManagedRoot)\Celeste.Modern.csproj')"
           Text="Stage 3B managed input is missing. Run scripts/prepare-celeste-tvos-runtime.sh." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and !Exists('$(CelesteRuntimeContentRoot)\Effects\Border.xnb')"
           Text="Stage 3B Content input is missing. Run scripts/prepare-celeste-tvos-runtime.sh without --managed-only." />
    <Error Condition="'$(CelesteRuntimeEnabled)' == 'true' and Exists('$(CelesteRuntimeContentRoot)\FMOD')"
           Text="Generated Celeste Content must not contain FMOD; device audio banks come only from accepted Stage 5A staging." />
    <Error Condition="'$(FmodNativeEnabled)' == 'true' and '$(RuntimeIdentifier)' == 'tvos-arm64' and !Exists('$(FmodDiagnosticStageRoot)\logical-manifest.json')"
           Text="Prepared Stage 5A FMOD inputs are missing. Run scripts/prepare-fmod-tvos.sh." />
    <Error Condition="'$(FmodNativeEnabled)' == 'true' and '$(RuntimeIdentifier)' == 'tvos-arm64' and !Exists('$(FmodDiagnosticStageRoot)\banks\Content\FMOD\Desktop\Master Bank.bank')"
           Text="Prepared Stage 5A FMOD banks are missing." />
    <Error Condition="'$(CelesteAudioEnabled)' == 'true' and !Exists('$(CelesteRuntimeManagedRoot)\Celeste\TvOSStage5BAudioBridge.cs')"
           Text="CelesteAudio requires the separately generated Stage 5B real-audio managed tree." />
  </Target>

  <Import Project="..\Local.Build.props" Condition="Exists('..\Local.Build.props')" />
</Project>
