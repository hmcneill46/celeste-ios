<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\IOSPortVersion.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <IOSPortBuildIdentityGenerated>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/IOSPortBuildIdentity.g.cs</IOSPortBuildIdentityGenerated>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IOSPortBuildIdentityGenerated)" />
  </ItemGroup>
  <Target Name="GenerateIOSPortBuildIdentity" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)..\..\scripts\generate-ios-port-build-identity.py&quot; --version-source &quot;$(MSBuildThisFileDirectory)..\IOSPortVersion.props&quot; --output &quot;$(IOSPortBuildIdentityGenerated)&quot;" />
  </Target>
</Project>
