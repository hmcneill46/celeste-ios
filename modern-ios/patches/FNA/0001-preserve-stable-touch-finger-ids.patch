+		internal static void SetFingerSnapshot(
+			ReadOnlySpan<int> fingerIds,
+			ReadOnlySpan<Vector2> fingerPositions
+		) {
+			if (fingerIds.Length != fingerPositions.Length || fingerIds.Length > MAX_TOUCHES)
+			{
+				throw new ArgumentException("Invalid touch snapshot.");
+			}
+
+			Span<int> previousSlotIds = stackalloc int[MAX_TOUCHES];
+			Span<int> nextSlotIds = stackalloc int[MAX_TOUCHES];
+			for (int slot = 0; slot < MAX_TOUCHES; slot += 1)
+			{
+				previousSlotIds[slot] =
+					prevTouches[slot].State == TouchLocationState.Invalid ||
+					prevTouches[slot].State == TouchLocationState.Released
+						? StableTouchSlotPolicy.Empty
+						: prevTouches[slot].Id;
+			}
+			StableTouchSlotPolicy.Map(previousSlotIds, fingerIds, nextSlotIds);
+
+			for (int slot = 0; slot < MAX_TOUCHES; slot += 1)
+			{
+				int id = nextSlotIds[slot];
+				if (id == StableTouchSlotPolicy.Empty || id == StableTouchSlotPolicy.Vacated)
+				{
+					SetFinger(slot, NO_FINGER, Vector2.Zero);
+					continue;
+				}
+				int finger = 0;
+				while (finger < fingerIds.Length && fingerIds[finger] != id) finger += 1;
+				if (finger == fingerIds.Length)
+				{
+					throw new InvalidOperationException("Stable touch mapping returned an unknown finger.");
+				}
+				SetFinger(slot, id, fingerPositions[finger]);
+			}
+		}
