<Project>
  <!--
    Single semantic version source for the modern Apple product.

    Celeste's game/content version remains 1.4.0.0.  These values drive the
    visible Options label, CFBundleShortVersionString, CFBundleVersion,
    iPhone/iPad/tvOS package verification, visible Options labels, output
    names, and release documentation checks.
  -->
  <PropertyGroup>
    <IOSPortSemanticVersion>0.1.1</IOSPortSemanticVersion>
    <IOSPortBuildNumber>41</IOSPortBuildNumber>
  </PropertyGroup>
</Project>
